#!/usr/bin/env python3
"""Resumo visual DA — leva 2 (itens 4, 5 e 6 do edital): P1-DA-4.1, 4.2, 4.3, 4.4, 5.1, 5.2, 6.1, 6.2, 6.3, 6.4, 6.5.
Produção Cowork (Fable), 28/10/2026, ESPEC_resumo_visual_DA_v3 (v3.1). Base de conteúdo: pacote v1.14 (resumo, emUmMinuto, baseLegal já
conferidos, extras_leva2_v114.json) e texto das normas; blocos dos resumos MapasPro só após a triagem (TRIAGEM_resumos_MapasPro_DA_leva2);
achados da conferência dirigida do ChatGPT (28/10) só nos estados "confirmado em fonte primária" ou "síntese doutrinária" rotulada.
Gera resumo_visual_leva2.json. Os blocos `lei` reaproveitam os dispositivos `baseLegal` do pacote (com `conferido`)."""
import json
EX = json.load(open('/home/claude/v17_3/extras_leva2_v114.json', encoding='utf-8'))
FONTE_COB = "Corpus Cebraspe 2025 (fila v2, enquadramento do pacote de auditoria, a confirmar no CDN; critério em reconciliação, T-155)."
def limpa(o):
    if isinstance(o, dict): return {k: limpa(v) for k, v in o.items()}
    if isinstance(o, list): return [limpa(v) for v in o]
    if isinstance(o, str): return o.replace("Pegadinha provável", "Pegadinha típica").replace("pegadinha provável", "pegadinha típica")
    return o
def _vis(tid, tipo, k=0):
    vs = [v for v in EX[tid]["visuais"] if v["tipo"] == tipo]; return vs[k]
def lei(tid, k=0, titulo=None):
    v = _vis(tid, "baseLegal", k); return limpa({"t": "lei", "titulo": titulo or v.get("titulo"), "norma": v.get("norma"), "dispositivos": v["dispositivos"]})
def _pac(tid, tipo, k=0, t=None):
    v = dict(_vis(tid, tipo, k)); v["t"] = t or tipo; v.pop("tipo"); return limpa(v)
def compare(tid, k=0): return _pac(tid, "compare", k)
def tabela_pacote(tid, k=0): return _pac(tid, "tabela", k)
def esquema_pacote(tid, k=0): return _pac(tid, "esquema", k)
def fluxo_pacote(tid, k=0): return _pac(tid, "fluxo", k)
S = lambda t, i="pino": {"t": "secao", "titulo": t, "icone": i}
U = lambda t, i=None: {"t": "sub", "titulo": t, **({"icone": i} if i else {})}
T = lambda md: {"t": "texto", "md": md}
L = lambda itens: {"t": "lista", "itens": itens}
B = lambda tipo, rotulo, md: {"t": "box", "tipo": tipo, "rotulo": rotulo, "md": md}
TB = lambda titulo, cols, rows, leg=None: {"t": "tabela", "titulo": titulo, "colunas": cols, "linhas": rows, **({"legenda": leg} if leg else {})}
DOIS = lambda titulo, a, ai, b, bi, pe=None, leg=None: {"t": "dois", "titulo": titulo, "a": {"titulo": a, "itens": ai}, "b": {"titulo": b, "itens": bi}, **({"pe": pe} if pe else {}), **({"legenda": leg} if leg else {})}
MAPA = lambda titulo, centro, ramos, leg=None: {"t": "mapa", "titulo": titulo, "centro": centro, "ramos": [{"titulo": r[0], "texto": r[1]} for r in ramos], **({"legenda": leg} if leg else {})}
ESC = lambda titulo, esq, dir, pontos, leg=None: {"t": "escala", "titulo": titulo, "esquerda": esq, "direita": dir, "pontos": [{"rotulo": p[0], "texto": p[1]} for p in pontos], **({"legenda": leg} if leg else {})}
LT = lambda titulo, marcos, leg=None: {"t": "linhaTempo", "titulo": titulo, "marcos": [{"quando": m[0], "titulo": m[1], "texto": m[2]} for m in marcos], **({"legenda": leg} if leg else {})}
FL = lambda titulo, passos: {"t": "fluxo", "titulo": titulo, "passos": passos}
REL = lambda itens: {"t": "relampago", "itens": itens}
PEG = lambda pares: {"t": "pegadinhas", "itens": [{"errado": e, "certo": c} for e, c in pares]}
R = {}
TESE_532 = "É constitucional a delegação do poder de polícia, por meio de lei, a pessoas jurídicas de direito privado integrantes da Administração Pública indireta de capital social majoritariamente público que prestem exclusivamente serviço público de atuação própria do Estado e em regime não concorrencial."
TESE_592 = "Em caso de inobservância de seu dever específico de proteção previsto no artigo 5º, inciso XLIX, da Constituição Federal, o Estado é responsável pela morte de detento."

# ===================== P1-DA-4.1 =====================
R["P1-DA-4.1"] = {"versao": "v3", "cobranca": {"itens": 0, "ce": 0, "fonte": FONTE_COB + " Nenhuma questão enquadrada neste item; a banca cobra o tema pelos itens 4.2, 4.3 e 4.4."},
 "blocos": [
  S("O que o edital chama de fontes", "livro"),
  T("\"Fontes\" do direito administrativo disciplinar é rótulo do edital, sem texto próprio na norma. O regime disciplinar do servidor federal vem da Constituição (ampla defesa e contraditório, art. 5º, LV; estabilidade e perda do cargo, art. 41), da Lei 8.112/1990 (deveres, proibições, responsabilidades, penalidades, sindicância e processo disciplinar, arts. 116 a 182) e, subsidiariamente, da Lei 9.784/1999 (art. 69)."),
  MAPA("De onde vêm as regras do regime disciplinar", "Regime disciplinar federal", [["CF, art. 5º, LV", "aos litigantes e aos acusados em geral, em processo judicial ou administrativo, são assegurados o contraditório e a ampla defesa"], ["CF, art. 41, § 1º, II", "o servidor estável só perde o cargo, entre outras hipóteses, mediante processo administrativo em que lhe seja assegurada ampla defesa"], ["Lei 8.112/1990, arts. 116 a 142", "deveres, proibições, acumulação, responsabilidades e penalidades"], ["Lei 8.112/1990, arts. 143 a 182", "sindicância, processo disciplinar, rito sumário e revisão"], ["Lei 9.784/1999, art. 69", "processos específicos seguem a lei própria; a Lei 9.784 só se aplica subsidiariamente"], ["STF, Súmula Vinculante 5", "a falta de defesa técnica por advogado no processo administrativo disciplinar não ofende a Constituição"]], "A lei própria vem primeiro; a Lei 9.784 preenche o que a Lei 8.112 não regula."),
  S("Princípios que a banca cobra", "balanca"),
  T("A Lei 9.784/1999, art. 2º, caput, enumera **onze** princípios, em rol exemplificativo: legalidade, finalidade, motivação, razoabilidade, proporcionalidade, moralidade, ampla defesa, contraditório, segurança jurídica, interesse público e eficiência. O parágrafo único traz critérios, também exemplificativos, como a adequação entre meios e fins e a garantia dos direitos à comunicação, às alegações finais, à produção de provas e aos recursos."),
  B("atencao", "Onze, não doze", "\"Devido processo legal\" e \"oficialidade\" não estão no caput do art. 2º da Lei 9.784: o devido processo é garantia constitucional (CF, art. 5º, LIV) e a impulsão de ofício é critério do parágrafo único (inciso XII). O caput tem onze princípios, e o rol diz \"dentre outros\"."),
  esquema_pacote("P1-DA-4.1", 0),
  DOIS("Independência das instâncias (Lei 8.112, arts. 125 e 126)", "Regra: independentes", ["Civil, penal e administrativa podem cumular-se (art. 125)", "A absolvição penal por falta de provas não afasta a sanção administrativa", "A sindicância ou o PAD não esperam o processo criminal"], "Exceção: a absolvição que nega o fato ou a autoria", ["Só a absolvição criminal que negue a existência do fato ou sua autoria afasta a responsabilidade administrativa (art. 126)", "Negar a culpa ou absolver por insuficiência de provas não basta"], "Mesmo fato, três esferas; só a negativa do fato ou da autoria comunica a absolvição"),
  lei("P1-DA-4.1", 0),
  REL(["\"Fontes\" é rótulo do edital: CF (arts. 5º, LV, e 41), Lei 8.112 (arts. 116 a 182) e Lei 9.784 só subsidiária (art. 69).", "Ciência de irregularidade obriga a apuração imediata, por sindicância ou PAD, com ampla defesa (Lei 8.112, art. 143).", "Quatro fatores na dosagem da pena: natureza e gravidade, danos ao serviço, agravantes/atenuantes, antecedentes (art. 128).", "O ato de imposição da penalidade menciona sempre o fundamento legal e a causa da sanção (art. 128, parágrafo único).", "Instâncias independentes e cumuláveis (art. 125); só a absolvição que nega o fato ou a autoria afasta a administrativa (art. 126).", "Lei 9.784, art. 2º: onze princípios no caput, rol exemplificativo; devido processo e oficialidade não estão no caput.", "No PAD, a falta de advogado não ofende a Constituição (Súmula Vinculante 5)."]),
  PEG([["A Lei 9.784/1999 enumera doze princípios no caput do art. 2º, entre eles o devido processo legal.", "São **onze**; o devido processo legal é garantia da CF (art. 5º, LIV), não consta do caput."], ["A absolvição criminal por insuficiência de provas afasta a responsabilidade administrativa.", "Só a absolvição que **negue a existência do fato ou sua autoria** afasta (art. 126)."], ["A Lei 9.784 prevalece sobre a Lei 8.112 no processo disciplinar.", "Os processos específicos seguem a lei própria; a Lei 9.784 aplica-se só subsidiariamente (art. 69)."], ["A autoridade pode aguardar o fim do processo criminal para apurar a infração disciplinar.", "A apuração é **imediata** (art. 143), e as instâncias são independentes (art. 125)."], ["A ausência de advogado no PAD anula o processo.", "Não ofende a Constituição (Súmula Vinculante 5); o acusado pode defender-se pessoalmente."]])],
 "ilustracaoSugerida": [],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, esquema e baseLegal de P1-DA-4.1", "CF, art. 5º, LIV e LV, art. 41, § 1º; Lei 8.112/1990, arts. 125, 126, 128 e 143; Lei 9.784/1999, arts. 2º e 69 (art. 2º, caput e parágrafo único, conferidos na Câmara dos Deputados, Legislação Informatizada, em 28/10/2026); STF, Súmula Vinculante 5", "MapasPro — Lei 8.112/90 (seções 11 e 13) e Lei do Processo Administrativo (seção 3), conferidos; a contagem \"12 princípios\" do PDF não entrou"]}

# ===================== P1-DA-4.2 =====================
R["P1-DA-4.2"] = {"versao": "v3", "cobranca": {"itens": 27, "ce": 23, "fonte": FONTE_COB},
 "blocos": [
  S("Onde estão os tipos e as penas", "cadeado"),
  T("O conceito de ilícito disciplinar é doutrinário: a Lei 8.112 traz os tipos nos **deveres** (art. 116), nas **proibições** (art. 117) e nas hipóteses de **demissão** (art. 132), e as penalidades no art. 127. A multa aparece só como conversão da suspensão (art. 130, § 2º)."),
  MAPA("Mapa do regime disciplinar na Lei 8.112", "Ilícito disciplinar", [["Deveres (art. 116)", "doze incisos: zelo, lealdade às instituições, cumprir ordens superiores, exceto as manifestamente ilegais, representar contra ilegalidade, entre outros"], ["Proibições (art. 117)", "dezenove incisos: ausentar-se sem autorização, nepotismo na chefia (VIII), valer-se do cargo (IX), gerência de sociedade (X), propina (XII), usura (XIV), desídia (XV)"], ["Penalidades (art. 127)", "advertência, suspensão, demissão, cassação de aposentadoria ou disponibilidade, destituição de cargo em comissão, destituição de função comissionada"], ["Dosagem (art. 128)", "natureza e gravidade, danos ao serviço, agravantes e atenuantes, antecedentes; o ato de punição cita o fundamento legal e a causa"], ["Demissão (art. 132)", "treze hipóteses: crime contra a administração, abandono, inassiduidade, improbidade, insubordinação grave, corrupção, acumulação ilegal, art. 117, IX a XVI, entre outras"], ["Prescrição (art. 142)", "5 anos (demissão, cassação, destituição de cargo em comissão), 2 anos (suspensão), 180 dias (advertência); corre do conhecimento do fato"]]),
  tabela_pacote("P1-DA-4.2", 0),
  S("Qual proibição leva a qual pena", "balanca"),
  ESC("Do mais leve ao mais grave", "Advertência", "Demissão", [["Advertência", "por escrito; art. 117, I a VIII e XIX, e dever funcional sem pena mais grave (art. 129)"], ["Suspensão", "reincidência em falta de advertência e demais proibições que não tipifiquem demissão; até 90 dias (art. 130)"], ["Demissão", "hipóteses do art. 132; inclui a transgressão do art. 117, IX a XVI (inciso XIII)"], ["Cassação", "de aposentadoria ou disponibilidade: infração punível com demissão praticada na atividade (art. 134)"], ["Destituição", "de cargo em comissão ou de função comissionada: infração sujeita a suspensão ou demissão (art. 135)"]], "Entre a advertência e a suspensão, o critério é o inciso do art. 117; entre a suspensão e a demissão, o art. 132."),
  TB("Prazos que a banca cobra (arts. 130, 131, 138, 139 e 142)", ["O quê", "Número", "Artigo"], [["Suspensão: limite", "90 dias; na recusa injustificada a inspeção médica, até 15 dias, cessando com o cumprimento", "art. 130, caput e § 1º"], ["Conversão da suspensão em multa", "50% por dia de vencimento ou remuneração, com o servidor em serviço, quando houver conveniência para o serviço", "art. 130, § 2º"], ["Cancelamento do registro", "advertência: 3 anos; suspensão: 5 anos de efetivo exercício sem nova infração", "art. 131"], ["Abandono de cargo", "ausência intencional por mais de 30 dias consecutivos", "art. 138"], ["Inassiduidade habitual", "falta sem causa justificada por 60 dias, interpoladamente, em 12 meses", "art. 139"], ["Prescrição da ação disciplinar", "5 anos, 2 anos, 180 dias; começa a correr da data em que o fato se tornou conhecido", "art. 142, I a III e § 1º"]], "Os prazos de prescrição previstos na lei penal aplicam-se às infrações disciplinares capituladas também como crime (art. 142, § 2º)."),
  B("regra", "Destituição de cargo em comissão (art. 135)", "A destituição de cargo em comissão exercido por não ocupante de cargo efetivo é aplicada nos casos de infração sujeita às penalidades de suspensão e de demissão. Para a prescrição, o STJ lê os arts. 135 e 142 em conjunto: dois anos se a infração era punível com suspensão, cinco se com demissão (EDcl no MS 18.327/DF, DJe 20/2/2013; leitura jurisprudencial, não texto do art. 142)."),
  B("atencao", "Demissão com efeitos patrimoniais (art. 136)", "A demissão ou a destituição de cargo em comissão por improbidade administrativa, aplicação irregular de dinheiros públicos, lesão aos cofres públicos ou corrupção (art. 132, IV, VIII, X e XI) implica a indisponibilidade dos bens e o ressarcimento ao erário, sem prejuízo da ação penal. O dispositivo é o art. 136, não um parágrafo do art. 132."),
  lei("P1-DA-4.2", 0),
  REL(["Tipos: deveres (art. 116), proibições (art. 117), demissão (art. 132); penas no art. 127; multa só como conversão da suspensão.", "Advertência: art. 117, I a VIII e XIX, e dever funcional sem pena maior (art. 129). Prescreve em 180 dias; cancela em 3 anos.", "Suspensão: reincidência e demais proibições; até 90 dias (art. 130). Prescreve em 2 anos; cancela em 5.", "Demissão: treze hipóteses do art. 132; inclui a transgressão do art. 117, IX a XVI. Prescreve em 5 anos; não cancela.", "Abandono: mais de 30 dias consecutivos (art. 138). Inassiduidade: 60 dias interpolados em 12 meses (art. 139).", "A prescrição corre da data em que o fato se tornou conhecido (art. 142, § 1º); crime segue o prazo penal (§ 2º).", "Cassação de aposentadoria: infração na atividade punível com demissão (art. 134). Destituição: art. 135.", "Improbidade, aplicação irregular, lesão aos cofres e corrupção: indisponibilidade de bens e ressarcimento (art. 136)."]),
  PEG([["A inassiduidade habitual exige mais de sessenta dias de falta interpolados em doze meses.", "**Sessenta** dias já bastam: \"por sessenta dias, interpoladamente\" (art. 139)."], ["O abandono de cargo configura-se com trinta dias de ausência.", "Ausência intencional por **mais de** trinta dias consecutivos (art. 138)."], ["A multa é penalidade autônoma do art. 127.", "A multa é só a conversão da suspensão, a 50% por dia de vencimento ou remuneração, com o servidor em serviço (art. 130, § 2º)."], ["A advertência prescreve em dois anos.", "Em **180 dias** (art. 142, III); dois anos é a suspensão (II)."], ["O servidor que procede de forma desidiosa fica sujeito a suspensão.", "A desídia é o art. 117, XV, que está entre os incisos IX a XVI: a pena é **demissão** (art. 132, XIII)."], ["O registro da demissão é cancelado após cinco anos sem nova infração.", "O art. 131 só cancela os registros de **advertência** (3 anos) e **suspensão** (5 anos)."], ["O prazo de prescrição corre da data da infração.", "Corre da data em que o fato se tornou **conhecido** (art. 142, § 1º)."]])],
 "ilustracaoSugerida": [{"onde": "junto da escala Do mais leve ao mais grave", "oQue": "cinco degraus com as penas e, em cada degrau, a porta de entrada (inciso do art. 117 ou do art. 132)", "porQue": "a banca troca a pena pela proibição; a imagem fixa qual inciso leva a qual pena"}],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, tabela e baseLegal de P1-DA-4.2", "Lei 8.112/1990, arts. 116, 117, 127 a 136, 138, 139, 141 e 142 (art. 130, § 2º, conferido na Câmara dos Deputados em 28/10/2026; os demais, pela conferência do pacote em 20/10/2026 e pela conferência dirigida de 28/10/2026, texto atualizado da Câmara)", "STJ, EDcl no MS 18.327/DF, DJe 20/2/2013 (prescrição da destituição de cargo em comissão; conferência dirigida de 28/10/2026, inteiro teor no portal do STJ)", "MapasPro — Lei 8.112/90 (seções 9 a 12), conferido; corrigidos \"> 60 dias\" e a referência \"art. 132, parágrafo único\" (é o art. 136)"]}

# ===================== P1-DA-4.3 =====================
R["P1-DA-4.3"] = {"versao": "v3", "cobranca": {"itens": 16, "ce": 13, "fonte": FONTE_COB},
 "blocos": [
  S("Sindicância e processo disciplinar", "doc"),
  T("A autoridade que tiver ciência de irregularidade é obrigada a promover a apuração imediata, por sindicância ou processo administrativo disciplinar (art. 143). A sindicância pode terminar em arquivamento, em advertência ou suspensão de até 30 dias, ou na instauração do PAD (art. 145); o PAD é obrigatório quando o ilícito ensejar suspensão por mais de 30 dias, demissão, cassação ou destituição de cargo em comissão (art. 146)."),
  compare("P1-DA-4.3", 0),
  LT("Do conhecimento do fato ao julgamento (Lei 8.112)", [["Ciência", "Apuração imediata", "sindicância ou PAD, assegurada ampla defesa (art. 143)"], ["30 + 30 dias", "Sindicância", "arquivamento, advertência ou suspensão de até 30 dias, ou instauração de PAD (art. 145); prorrogável por igual período (parágrafo único)"], ["Dia 0 do PAD", "Instauração", "publicação do ato que constitui a comissão de três servidores estáveis (arts. 149 e 151, I)"], ["60 + 60 dias", "Inquérito administrativo", "instrução, defesa e relatório (art. 151, II); prazo contado da publicação do ato que constitui a comissão (art. 152)"], ["10 ou 20 dias", "Defesa escrita", "10 dias para um indiciado; 20 dias, comuns, para dois ou mais (art. 161, §§ 1º e 2º); revelia: defensor dativo (art. 164)"], ["20 dias", "Julgamento", "contados do recebimento do processo pela autoridade julgadora (art. 167)"]], "O rito sumário (acumulação ilegal, abandono e inassiduidade) tem comissão de dois estáveis e 30 dias, prorrogáveis por até 15 (arts. 133 e 140)."),
  S("Comissão, instrução e defesa", "pessoas"),
  MAPA("A comissão do PAD (arts. 149 a 156)", "Comissão processante", [["Três servidores estáveis", "designados pela autoridade competente; o presidente é ocupante de cargo efetivo superior ou de mesmo nível, ou com escolaridade igual ou superior à do indiciado (art. 149)"], ["Impedimentos (art. 149, § 2º)", "não pode participar cônjuge, companheiro ou parente do acusado, consanguíneo ou afim, em linha reta ou colateral, até o terceiro grau"], ["Independência (art. 150)", "a comissão exerce suas atividades com independência e imparcialidade; as reuniões e audiências têm caráter reservado"], ["Instrução (arts. 153 a 160)", "contraditório, provas, testemunhas e diligências; a lei não fixa número máximo de testemunhas (art. 156)"], ["Indiciação e defesa (arts. 161 a 164)", "citação para defesa escrita em 10 dias; 20 dias, comuns, para dois ou mais indiciados; revelia: defensor dativo"], ["Relatório (art. 165)", "conclusivo quanto à inocência ou à responsabilidade; indica o dispositivo transgredido e as circunstâncias"]]),
  DOIS("Rito ordinário × rito sumário", "Rito ordinário (arts. 148 a 167)", ["Comissão de três servidores estáveis", "60 dias, prorrogáveis por igual prazo (art. 152)", "Defesa em 10 ou 20 dias (art. 161)", "Julgamento em 20 dias (art. 167)"], "Rito sumário (arts. 133 e 140)", ["Acumulação ilegal de cargos, abandono de cargo e inassiduidade habitual", "Comissão de dois servidores estáveis", "30 dias, prorrogáveis por até 15", "Na acumulação ilegal, o servidor pode optar por um dos cargos até o último dia da defesa, e o processo é arquivado"], "O que muda é a comissão e o prazo; a ampla defesa é a mesma"),
  B("regra", "Revisão do processo (arts. 174 a 182)", "O processo disciplinar pode ser revisto, a qualquer tempo, a pedido ou de ofício, quando se aduzirem fatos novos ou circunstâncias suscetíveis de justificar a inocência do punido ou a inadequação da penalidade. O ônus da prova cabe ao requerente (art. 175), e da revisão não pode resultar agravamento da penalidade (art. 182, parágrafo único)."),
  B("atencao", "Sem advogado, sem nulidade", "A falta de defesa técnica por advogado no processo administrativo disciplinar não ofende a Constituição (Súmula Vinculante 5). O que não pode faltar é a oportunidade de defesa: citação, prazo e vista dos autos."),
  fluxo_pacote("P1-DA-4.3", 0),
  REL(["Apuração imediata e obrigatória: sindicância ou PAD, com ampla defesa (art. 143).", "Sindicância: 30 + 30 dias; resultado: arquivamento, advertência ou suspensão de até 30 dias, ou PAD (art. 145).", "PAD obrigatório: suspensão > 30 dias, demissão, cassação, destituição de cargo em comissão (art. 146).", "Três fases: instauração, inquérito (instrução, defesa, relatório) e julgamento (art. 151).", "Comissão: três estáveis; presidente de nível ou escolaridade igual ou superior; parentes até 3º grau impedidos (art. 149).", "PAD: 60 + 60 dias da publicação do ato que constitui a comissão (art. 152); julgamento em 20 dias (art. 167).", "Defesa escrita: 10 dias; 20 comuns se dois ou mais indiciados (art. 161); revel: defensor dativo (art. 164).", "Rito sumário: acumulação ilegal, abandono, inassiduidade; dois estáveis; 30 + 15 dias (arts. 133 e 140).", "Revisão: a qualquer tempo, ônus do requerente, sem agravar a pena (arts. 174, 175 e 182)."]),
  PEG([["O prazo de defesa escrita no PAD é de dez dias, qualquer que seja o número de indiciados.", "Dez dias para um indiciado; **vinte dias, comuns**, se houver dois ou mais (art. 161, §§ 1º e 2º)."], ["O prazo do PAD conta-se da data do fato.", "Sessenta dias contados da **publicação do ato que constituir a comissão** (art. 152)."], ["A sindicância não pode aplicar penalidade.", "Pode resultar em advertência ou suspensão de **até 30 dias** (art. 145, II)."], ["A comissão do PAD pode ouvir no máximo dez testemunhas por fato.", "A lei **não fixa** número máximo de testemunhas (art. 156)."], ["A revisão do processo pode agravar a penalidade.", "Da revisão **não pode resultar agravamento** (art. 182, parágrafo único)."], ["O julgamento deve ocorrer em sessenta dias.", "A autoridade julgadora decide em **20 dias** do recebimento do processo (art. 167)."], ["Qualquer servidor pode integrar a comissão do PAD.", "Três servidores **estáveis**, sem parentesco até o terceiro grau com o acusado (art. 149)."]])],
 "ilustracaoSugerida": [{"onde": "junto da linha do tempo", "oQue": "uma régua de prazos com quatro marcas: 30+30 (sindicância), 60+60 (PAD), 10/20 (defesa) e 20 (julgamento)", "porQue": "os quatro números são trocados entre si pela banca"}],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, compare e fluxo de P1-DA-4.3", "Lei 8.112/1990, arts. 133, 140, 143 a 156, 161, 164, 165, 167, 174, 175 e 182 (pela conferência do pacote em 20/10/2026 e pela conferência dirigida de 28/10/2026, texto atualizado da Câmara); STF, Súmula Vinculante 5", "MapasPro — Lei 8.112/90 (seção 13), conferido; corrigidos \"até 10 testemunhas\", \"defesa: art. 164\" (é o art. 161, § 1º) e \"impedimentos: art. 150\" (é o art. 149, § 2º)"]}

# ===================== P1-DA-4.4 =====================
R["P1-DA-4.4"] = {"versao": "v3", "cobranca": {"itens": 56, "ce": 47, "fonte": FONTE_COB},
 "blocos": [
  S("Âmbito e princípios", "livro"),
  T("A Lei 9.784/1999 estabelece normas básicas sobre o processo administrativo na Administração Federal direta e indireta (art. 1º); seus preceitos também se aplicam aos órgãos dos Poderes Legislativo e Judiciário da União, no desempenho de função administrativa (§ 1º). O processo pode iniciar-se de ofício ou a pedido de interessado (art. 5º); são capazes, para fins de processo administrativo, os maiores de dezoito anos (art. 10)."),
  MAPA("A quem e a quê a lei se aplica", "Lei 9.784/1999", [["Administração Federal", "direta e indireta (art. 1º); Legislativo e Judiciário da União em função administrativa (§ 1º)"], ["Órgão, entidade, autoridade", "unidade sem personalidade; unidade com personalidade; servidor com poder de decisão (art. 1º, § 2º)"], ["Interessados (art. 9º)", "quem inicia o processo, quem tem direitos ou interesses que possam ser afetados, organizações e associações (interesses coletivos) e pessoas ou associações (interesses difusos)"], ["Início (art. 5º)", "de ofício ou a pedido; requerimento por escrito, salvo solicitação oral admitida (art. 6º)"], ["Processos específicos (art. 69)", "seguem a lei própria; a Lei 9.784 é subsidiária"], ["Capacidade (art. 10)", "maiores de dezoito anos, ressalvada previsão especial em ato normativo próprio"]]),
  L(["Os **onze** princípios do art. 2º, caput: legalidade, finalidade, motivação, razoabilidade, proporcionalidade, moralidade, ampla defesa, contraditório, segurança jurídica, interesse público e eficiência — \"dentre outros\".", "Critérios do parágrafo único (I a XIII): atuação conforme a lei e o Direito; objetividade; adequação entre meios e fins; impulsão de ofício (XII); interpretação que melhor garanta o fim público (XIII)."]),
  S("Prazos e fases", "relogio"),
  tabela_pacote("P1-DA-4.4", 0),
  LT("Do pedido à decisão do recurso (Lei 9.784)", [["Início", "Instauração", "de ofício ou a pedido (art. 5º); impedimento e suspeição do servidor (arts. 18 a 21)"], ["Instrução", "Provas e diligências", "de ofício ou a pedido (art. 29); provas obtidas por meios ilícitos são inadmissíveis (art. 30); consulta pública a critério da autoridade (art. 32)"], ["Até 10 dias", "Alegações finais", "encerrada a instrução, o interessado manifesta-se em até dez dias, salvo outro prazo legal (art. 44)"], ["Relatório", "Órgão de instrução", "relatório com o pedido inicial, o conteúdo das fases e proposta objetivamente justificada (art. 47)"], ["30 + 30 dias", "Decisão", "dever de decidir (art. 48); até trinta dias após a instrução, prorrogáveis por igual período, motivadamente (art. 49)"], ["10 dias", "Recurso", "interposição em dez dias da ciência (art. 59); dirigido à autoridade que decidiu, que pode reconsiderar em cinco dias (art. 56, § 1º)"], ["30 + 30 dias", "Decisão do recurso", "pela autoridade superior (art. 59, § 1º); no máximo três instâncias (art. 57); sem efeito suspensivo, salvo lei (art. 61)"]], "Os prazos em dias contam-se de modo contínuo, excluído o dia do começo e incluído o do vencimento (art. 66)."),
  DOIS("Impedimento × suspeição (arts. 18 a 21)", "Impedimento (art. 18)", ["Interesse direto ou indireto na matéria", "Participação como perito, testemunha ou representante, ou situação que alcance cônjuge, companheiro ou parente até o terceiro grau", "Litígio judicial ou administrativo com o interessado", "Omitir a comunicação do impedimento é falta grave (art. 19)"], "Suspeição (art. 20)", ["Amizade íntima ou inimizade notória com o interessado ou com seu cônjuge, companheiro ou parente até o terceiro grau", "Pode ser arguida; o indeferimento pode ser objeto de recurso, sem efeito suspensivo (art. 21)"], "Impedimento é causa objetiva; suspeição é causa subjetiva"),
  B("regra", "Motivação obrigatória (art. 50, I a VIII)", "Devem ser motivados os atos que: neguem, limitem ou afetem direitos ou interesses; imponham ou agravem deveres, encargos ou sanções; decidam processos de concurso ou seleção pública; dispensem ou declarem a inexigibilidade de licitação; decidam recursos administrativos; decorram de reexame de ofício; deixem de aplicar jurisprudência firmada ou discrepem de pareceres, laudos, propostas e relatórios oficiais; importem anulação, revogação, suspensão ou convalidação de ato. A motivação deve ser explícita, clara e congruente (§ 1º)."),
  B("atencao", "Recurso: o que a lei diz de fato", "O recurso tramita por, no máximo, três instâncias (art. 57). É interposto em dez dias (art. 59) e dirigido à autoridade que proferiu a decisão, que o reconsidera em cinco dias ou o encaminha à superior (art. 56, § 1º). Em regra não tem efeito suspensivo; a autoridade pode dá-lo de ofício ou a pedido, havendo justo receio de prejuízo de difícil ou incerta reparação (art. 61). Não é conhecido quando interposto fora do prazo, perante órgão incompetente, por quem não é legitimado ou após exaurida a esfera administrativa (art. 63); o não conhecimento não impede a revisão de ofício do ato ilegal, desde que não ocorrida a preclusão administrativa (§ 2º)."),
  lei("P1-DA-4.4", 0),
  REL(["Âmbito: Administração Federal direta e indireta; Legislativo e Judiciário da União em função administrativa (art. 1º).", "Onze princípios no caput do art. 2º, \"dentre outros\"; impulsão de ofício é critério do parágrafo único, XII.", "Atos sem prazo específico: cinco dias, dilatáveis até o dobro (art. 24); intimação com três dias úteis de antecedência (art. 26, § 2º).", "Alegações finais: até dez dias após a instrução (art. 44). Decisão: até 30 dias, prorrogáveis por igual período (art. 49).", "Recurso: dez dias (art. 59); reconsideração pela autoridade em cinco dias (art. 56, § 1º); três instâncias no máximo (art. 57).", "Recurso sem efeito suspensivo, salvo lei; a autoridade pode concedê-lo por justo receio de prejuízo (art. 61).", "Anular ato de efeitos favoráveis: decadência de cinco anos, salvo má-fé (art. 54); prazos contínuos (art. 66).", "Impedimento: interesse, parentesco, litígio (art. 18); suspeição: amizade íntima ou inimizade notória (art. 20)."]),
  PEG([["A Lei 9.784 enumera doze princípios no caput do art. 2º.", "São **onze**; \"devido processo legal\" não está no caput."], ["O prazo de alegações finais está no art. 32 da Lei 9.784.", "O art. 32 trata da **consulta pública**; as alegações finais (dez dias) estão no **art. 44**."], ["O pedido de reconsideração tem prazo de cinco dias para o interessado.", "Os cinco dias são da **autoridade** para reconsiderar (art. 56, § 1º); o interessado recorre em dez dias (art. 59)."], ["A revisão de ofício é um dos princípios do art. 2º da Lei 9.784.", "O parágrafo único do art. 2º termina no inciso **XIII**; a revisão de ofício do ato ilegal está nos arts. 53 e 63, § 2º."], ["O recurso administrativo tem efeito suspensivo automático.", "Em regra **não** tem; a autoridade pode concedê-lo, havendo justo receio de prejuízo (art. 61)."], ["Os prazos da Lei 9.784 contam-se em dias úteis.", "Contam-se de modo **contínuo**, excluído o dia do começo e incluído o do vencimento (art. 66)."], ["A Administração pode anular a qualquer tempo ato de que decorram efeitos favoráveis.", "Decai em **cinco anos**, salvo comprovada má-fé (art. 54)."], ["Amizade íntima com o interessado é causa de impedimento.", "É causa de **suspeição** (art. 20); impedimento é interesse, participação ou litígio (art. 18)."]])],
 "ilustracaoSugerida": [{"onde": "junto da linha do tempo Do pedido à decisão do recurso", "oQue": "um corredor com portas numeradas (10, 30+30, 10, 5, 30+30) e três degraus no fim (as três instâncias)", "porQue": "a banca troca os prazos entre si e inventa instâncias a mais"}],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, tabela e baseLegal de P1-DA-4.4", "Lei 9.784/1999, arts. 1º, 2º, 5º, 6º, 9º, 10, 18 a 21, 24, 26, 29, 30, 32, 44, 47 a 50, 53, 54, 56, 57, 59, 61, 63, 66 e 69 (arts. 2º, parágrafo único, 32, 44, 56, § 1º, 59, 61 e 63, § 2º, conferidos na Câmara dos Deputados, Legislação Informatizada, em 28/10/2026)", "MapasPro — Lei do Processo Administrativo (seções 3 a 11), conferido; não entraram \"12 princípios\", \"alegações finais art. 32\", \"reconsideração art. 61\" e \"art. 2º, XXI\""]}

# ===================== P1-DA-5.1 =====================
R["P1-DA-5.1"] = {"versao": "v3", "cobranca": {"itens": 32, "ce": 28, "fonte": FONTE_COB},
 "blocos": [
  S("Os poderes administrativos", "chave"),
  T("Os poderes administrativos são prerrogativas instrumentais para a persecução do interesse público; por isso são **poderes-deveres**: presentes os pressupostos legais, o exercício é obrigatório. A classificação em discricionário, hierárquico, disciplinar, regulamentar e de polícia é doutrinária; a base textual está na Lei 9.784 (competência), na CF (regulamentar) e no CTN (polícia)."),
  MAPA("Cinco poderes, cinco perguntas", "Poderes administrativos", [["Discricionário", "a lei deixa margem de conveniência e oportunidade; o Judiciário controla a legalidade sem substituir o mérito"], ["Hierárquico", "escalonar, ordenar, fiscalizar, rever atos, delegar e avocar dentro da mesma pessoa jurídica (Lei 9.784, arts. 11 a 17)"], ["Disciplinar", "apurar infrações e punir servidores e demais sujeitos a vínculo especial; a apuração é dever (Lei 8.112, art. 143)"], ["Regulamentar", "decretos e regulamentos para a fiel execução da lei (CF, art. 84, IV); decreto sobre organização da administração (inciso VI)"], ["De polícia", "limitar ou disciplinar direito, interesse ou liberdade em razão de interesse público (CTN, art. 78)"]], "Discricionariedade não é um poder à parte: é o modo de exercício dos demais quando a lei dá escolha."),
  S("Hierárquico: delegação e avocação", "pessoas"),
  DOIS("Delegação × avocação (Lei 9.784/1999, arts. 11 a 15)", "Delegação (arts. 12 a 14)", ["A órgãos ou titulares, ainda que não subordinados, se conveniente (art. 12)", "Indelegáveis: edição de atos normativos, decisão de recursos, matérias de competência exclusiva (art. 13)", "Ato de delegação publicado; revogável a qualquer tempo (art. 14)", "O delegado é considerado o autor das decisões (art. 14, § 3º)"], "Avocação (art. 15)", ["Em caráter excepcional e por motivos relevantes devidamente justificados", "Temporária", "De competência de órgão hierarquicamente inferior"], "A competência é irrenunciável, salvo delegação e avocação legalmente admitidas (art. 11)"),
  S("Regulamentar", "doc"),
  compare("P1-DA-5.1", 0),
  B("atencao", "O que o decreto não pode", "O regulamento de execução não inova: não cria direitos nem obrigações além da lei. O decreto do art. 84, VI, dispõe sobre organização e funcionamento da administração federal sem aumento de despesa nem criação ou extinção de órgãos, e extingue funções ou cargos vagos. O Congresso Nacional susta os atos normativos que exorbitem do poder regulamentar ou dos limites de delegação legislativa (CF, art. 49, V)."),
  S("De polícia", "cadeado"),
  MAPA("Poder de polícia: conceito, atributos e ciclo", "Poder de polícia", [["Conceito legal (CTN, art. 78)", "atividade da administração que limita ou disciplina direito, interesse ou liberdade, regula a prática de ato ou abstenção de fato, em razão de interesse público"], ["Exercício regular (parágrafo único)", "pelo órgão competente, nos limites da lei aplicável, com observância do processo legal e, na atividade discricionária, sem abuso ou desvio de poder"], ["Atributos (doutrina)", "discricionariedade, autoexecutoriedade e coercibilidade; nem todo ato tem todos"], ["Ciclo de polícia (doutrina)", "ordem, consentimento, fiscalização e sanção"], ["Multa: impor ≠ cobrar", "a imposição é unilateral; a cobrança forçada vai pela execução fiscal (Lei 6.830/1980), não pela autoexecutoriedade"], ["Administrativa × judiciária", "a administrativa incide sobre bens, direitos e atividades; a judiciária, sobre pessoas, na repressão de ilícitos penais (doutrina)"]]),
  B("regra", "Delegação do poder de polícia — Tema 532 do STF (RE 633.782)", "Tese: \"" + TESE_532 + "\" O caso julgado tratava da aplicação de multas de trânsito por sociedade de economia mista; os requisitos são cumulativos e a tese não autoriza delegação genérica a particulares."),
  lei("P1-DA-5.1", 0),
  REL(["Poder-dever: presentes os pressupostos legais, exercer o poder é obrigatório, não faculdade.", "Competência irrenunciável; delegação a não subordinados é possível; avocação é excepcional e temporária (Lei 9.784, arts. 11 a 15).", "Indelegáveis: ato normativo, decisão de recurso e competência exclusiva (art. 13).", "Regulamento de execução (CF, art. 84, IV) não inova; decreto do art. 84, VI: organização sem despesa e cargos vagos.", "O Congresso susta ato normativo que exorbite do poder regulamentar ou da delegação legislativa (art. 49, V).", "Poder de polícia: limita direito, interesse ou liberdade em razão de interesse público (CTN, art. 78).", "Atributos (doutrina): discricionariedade, autoexecutoriedade, coercibilidade; a cobrança da multa não é autoexecutória.", "Tema 532: delegação por lei a pessoa privada da indireta, capital majoritariamente público, serviço próprio do Estado, sem concorrência.", "Poder disciplinar alcança quem tem vínculo especial; poder de polícia alcança a generalidade dos particulares."]),
  PEG([["A autoexecutoriedade permite à Administração cobrar a multa de polícia sem ação judicial.", "A multa é **imposta** unilateralmente, mas sua cobrança forçada exige **execução fiscal** (Lei 6.830/1980)."], ["O poder de polícia não pode ser delegado a pessoa jurídica de direito privado em nenhuma hipótese.", "Pode, **por lei**, a pessoa de direito privado da Administração indireta, de capital majoritariamente público, que preste exclusivamente serviço público próprio do Estado em regime não concorrencial (Tema 532)."], ["Segundo o STF, só o consentimento e a fiscalização de polícia são delegáveis.", "A tese do Tema 532 não limita a delegação a essas fases; o caso julgado era de **aplicação de multa**."], ["Por decreto, o Presidente pode criar órgãos para organizar a administração federal.", "O decreto do art. 84, VI, **não** pode criar ou extinguir órgãos nem aumentar despesa."], ["A edição de atos normativos pode ser delegada ao subordinado.", "É **indelegável** (Lei 9.784, art. 13, I), como a decisão de recursos e a competência exclusiva."], ["A avocação é definitiva e dispensa motivação.", "É **temporária**, excepcional e por motivos relevantes justificados (art. 15)."], ["A delegação só pode ser feita a órgão subordinado.", "Pode alcançar órgãos ou titulares **não subordinados**, quando conveniente (art. 12)."]])],
 "ilustracaoSugerida": [{"onde": "junto do mapa do poder de polícia", "oQue": "o ciclo em quatro casas (ordem, consentimento, fiscalização, sanção) com a multa saindo da casa da sanção por uma porta marcada \"execução fiscal\"", "porQue": "a troca entre impor a multa e cobrá-la é o erro mais comum no item"}],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, compare e baseLegal de P1-DA-5.1", "Lei 9.784/1999, arts. 11 a 15; CF, arts. 49, V, e 84, IV e VI; CTN, art. 78; Lei 6.830/1980, arts. 1º, 6º e 7º (conferência dirigida de 28/10/2026, Câmara); Lei 8.112/1990, art. 143", "STF, Tema 532 (RE 633.782): tese transcrita do portal do STF na conferência dirigida de 28/10/2026 (segunda leitura, confirmado em fonte primária); a reconferir pelo QA", "MapasPro — Poderes Administrativos (seções 2 a 8), conferido; não entrou \"apenas consentimento e fiscalização são delegáveis\""]}

# ===================== P1-DA-5.2 =====================
R["P1-DA-5.2"] = {"versao": "v3", "cobranca": {"itens": 7, "ce": 3, "fonte": FONTE_COB + " Poucas questões neste item; o tema reaparece em 2.1 (vícios do ato) e 5.1."},
 "blocos": [
  S("Uso regular e abuso", "balanca"),
  T("O poder conferido à autoridade é instrumento do interesse público: presentes os pressupostos legais, exercê-lo é **dever**. O **abuso de poder** é o gênero (categoria doutrinária); suas espécies são o **excesso de poder**, ligado à competência do agente, e o **desvio de poder** ou desvio de finalidade, ligado ao fim do ato. A base textual está na Lei 4.717/1965, art. 2º, a e e, e no CTN, art. 78, parágrafo único."),
  compare("P1-DA-5.2", 0),
  MAPA("Como o abuso aparece e como se controla", "Abuso de poder", [["Excesso de poder", "o agente atua fora de suas atribuições legais: vício de competência (Lei 4.717, art. 2º, a)"], ["Desvio de poder", "o agente, competente, pratica o ato visando a fim diverso do previsto na regra de competência (art. 2º, e); o ato é nulo"], ["Omissão abusiva (doutrina)", "recusar-se a exercer o poder quando a lei obriga também é abuso: poder-dever"], ["Controle interno", "autotutela: a Administração anula seus atos ilegais (Súmula 473; Lei 9.784, art. 53)"], ["Controle judicial", "anulação do ato; mandado de segurança contra ilegalidade ou abuso de poder (CF, art. 5º, LXIX); ação popular contra ato lesivo (Lei 4.717)"], ["Controle legislativo", "o Congresso susta atos normativos do Executivo que exorbitem do poder regulamentar ou da delegação legislativa (CF, art. 49, V)"]]),
  B("atencao", "Desvio com competência", "No desvio de finalidade a competência **existe**; o que falta é a finalidade legal. Por isso o ato parece regular na forma e só se revela viciado pela prova do fim real. O ato é nulo, não meramente anulável, e não se convalida."),
  lei("P1-DA-5.2", 0),
  REL(["Abuso de poder é gênero; excesso (competência) e desvio (finalidade) são espécies — categorias doutrinárias.", "Incompetência: ato fora das atribuições legais do agente (Lei 4.717, art. 2º, parágrafo único, a).", "Desvio de finalidade: fim diverso do previsto, explícita ou implicitamente, na regra de competência (alínea e); ato nulo.", "O desvio pode existir ainda que a competência exista; o excesso é a falta dela.", "Poder-dever: a omissão no exercício do poder, quando a lei obriga, também é abuso (doutrina).", "Controle: autotutela (Súmula 473), mandado de segurança (CF, art. 5º, LXIX), ação popular (Lei 4.717), sustação pelo Congresso (art. 49, V)."]),
  PEG([["Agente que usa competência legítima para fim diverso do legal comete excesso de poder.", "Comete **desvio de poder** (desvio de finalidade); excesso é agir fora da competência."], ["O ato com desvio de finalidade é anulável e pode ser convalidado.", "É **nulo** (Lei 4.717, art. 2º, e) e não se convalida."], ["Só há abuso de poder quando o agente age; a omissão nunca configura abuso.", "A recusa de exercer o poder quando a lei obriga também é abuso, porque o poder é **dever** (doutrina)."], ["A sustação do art. 49, V, alcança qualquer ato do Executivo.", "Alcança os **atos normativos** que exorbitem do poder regulamentar ou dos limites de delegação legislativa."], ["O desvio de finalidade pressupõe incompetência do agente.", "Não: no desvio a competência **existe**; o vício está no fim."]])],
 "ilustracaoSugerida": [],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, compare e baseLegal de P1-DA-5.2", "Lei 4.717/1965, art. 2º, a e e, e parágrafo único; CTN, art. 78, parágrafo único; CF, arts. 5º, LXIX, e 49, V; Lei 9.784/1999, art. 53; STF, Súmula 473", "MapasPro — Poderes Administrativos (seção 9), conferido"]}

# ===================== P1-DA-6.1 =====================
R["P1-DA-6.1"] = {"versao": "v3", "cobranca": {"itens": 19, "ce": 14, "fonte": FONTE_COB},
 "blocos": [
  S("A regra do § 6º", "balanca"),
  T("Pela CF, art. 37, § 6º, as pessoas jurídicas de direito público e as de direito privado prestadoras de serviços públicos respondem pelos danos que seus agentes, nessa qualidade, causarem a terceiros, assegurado o direito de regresso contra o responsável nos casos de dolo ou culpa. A responsabilidade é, como regra, **objetiva**, na modalidade do **risco administrativo**, que admite excludentes."),
  LT("Como se chegou ao risco administrativo (evolução doutrinária)", [["Antes", "Irresponsabilidade", "o Estado não respondia pelos danos que causava"], ["Depois", "Responsabilidade subjetiva", "o Estado respondia mediante prova da culpa do agente, com regras civilistas"], ["Em seguida", "Culpa do serviço", "bastava provar a falha do serviço (que não funcionou, funcionou mal ou tarde), sem individualizar o agente"], ["Hoje", "Risco administrativo", "responsabilidade objetiva, sem culpa, com excludentes (CF, art. 37, § 6º)"], ["Exceção apontada pela doutrina", "Risco integral", "sem excludentes; a doutrina aponta como exemplo os danos nucleares (CF, art. 21, XXIII, d: responsabilidade independe de culpa)"]], "Os nomes das teorias são doutrinários; o texto constitucional é o § 6º."),
  compare("P1-DA-6.1", 0),
  MAPA("Quem responde pelo § 6º", "Art. 37, § 6º", [["Pessoa jurídica de direito público", "União, Estados, DF, Municípios, autarquias e fundações de direito público"], ["Pessoa de direito privado prestadora de serviço público", "concessionárias, permissionárias, empresas públicas e sociedades de economia mista que prestam serviço público"], ["Fora da letra", "a pessoa de direito privado que explora atividade econômica, sem prestar serviço público"], ["Agente, nessa qualidade", "quem causa o dano atuando como agente; o regresso contra ele exige dolo ou culpa"]]),
  B("regra", "Risco administrativo × risco integral", "No risco administrativo, a responsabilidade é objetiva mas admite causas excludentes (força maior, fato exclusivo de terceiro, culpa exclusiva da vítima). No risco integral, conceitualmente, não há excludentes. A regra brasileira é o risco administrativo."),
  lei("P1-DA-6.1", 0),
  REL(["Base: CF, art. 37, § 6º — pessoas de direito público e de direito privado prestadoras de serviço público respondem pelos danos dos agentes.", "Objetiva, na modalidade do risco administrativo: sem culpa, mas com excludentes.", "Regresso contra o agente só com dolo ou culpa; a culpa basta.", "O art. 43 do Código Civil cita só as pessoas de direito público interno; não menciona as prestadoras de serviço público.", "A requisição do art. 5º, XXV, da CF (indenização ulterior) não é fundamento da responsabilidade civil do Estado.", "Evolução (doutrina): irresponsabilidade, subjetiva, culpa do serviço, risco administrativo.", "Risco integral não admite excludentes; a doutrina o aponta nos danos nucleares (CF, art. 21, XXIII, d)."]),
  PEG([["O Estado responde objetivamente por todo dano sofrido por particulares.", "Responde quando presentes conduta de agente nessa qualidade, dano e nexo; o Estado **não é segurador universal**."], ["A responsabilidade objetiva do Estado dispensa a prova do dano.", "Dispensa a prova da **culpa**; dano e nexo continuam exigidos."], ["O Código Civil, art. 43, responsabiliza as prestadoras privadas de serviço público.", "O art. 43 cita só as pessoas jurídicas de **direito público interno**; as prestadoras estão no § 6º da CF."], ["A regra brasileira é o risco integral.", "É o **risco administrativo**, que admite excludentes."], ["O regresso contra o agente é objetivo.", "Depende de **dolo ou culpa** do agente (CF, art. 37, § 6º)."]])],
 "ilustracaoSugerida": [{"onde": "junto do mapa Quem responde", "oQue": "um triângulo vítima → pessoa jurídica → agente, com a seta da vítima marcada \"objetiva\" e a seta do regresso marcada \"dolo ou culpa\"", "porQue": "a banca troca os dois regimes e inverte o sentido da ação regressiva"}],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, compare e baseLegal de P1-DA-6.1", "CF, art. 5º, XXV, art. 21, XXIII, d, art. 37, § 6º; Código Civil, art. 43", "MapasPro — Responsabilidade Civil do Estado (seções 2 e 3), conferido; não entrou \"Estado sempre paga\" nem a responsabilidade objetiva como exclusiva do ato ilícito"]}

# ===================== P1-DA-6.2 =====================
R["P1-DA-6.2"] = {"versao": "v3", "cobranca": {"itens": 8, "ce": 6, "fonte": FONTE_COB},
 "blocos": [
  S("Ato comissivo: quem responde e por quê", "pessoas"),
  T("\"Ato comissivo\" é rótulo doutrinário para a conduta positiva do agente. A base textual é o § 6º do art. 37 da CF: respondem as pessoas jurídicas de direito público e as de direito privado prestadoras de serviços públicos, como a concessionária e a permissionária. Na responsabilidade objetiva, o dever de indenizar decorre do **dano causado pela conduta**, e não da ilicitude dela: a conduta comissiva **lícita** também pode gerar dever de indenizar."),
  tabela_pacote("P1-DA-6.2", 0),
  compare("P1-DA-6.2", 0),
  DOIS("Perante a vítima × regresso contra o agente", "Pessoa jurídica perante a vítima", ["Responsabilidade objetiva: conduta, dano e nexo", "Sem prova de culpa da pessoa jurídica ou do agente", "A conduta lícita também pode gerar o dever de indenizar"], "Regresso contra o agente", ["Só nos casos de dolo ou culpa (CF: \"contra o responsável\"; Código Civil: \"contra os causadores do dano\")", "A culpa basta", "O regresso não afasta a responsabilidade perante o terceiro"], "Dois vínculos, dois regimes: objetivo para fora, subjetivo para dentro"),
  B("atencao", "Lícito também indeniza", "Responsabilidade objetiva não se confunde com responsabilidade por ato ilícito: o que importa é o dano causado pela conduta do agente, nessa qualidade. Um ato lícito que cause dano anormal e específico a alguém pode gerar o dever de indenizar."),
  REL(["Ato comissivo = ação positiva do agente, nessa qualidade (CF, art. 37, § 6º).", "Respondem pessoas de direito público e prestadoras privadas de serviço público: concessionária, permissionária.", "Objetiva perante a vítima: o dever de indenizar vem do dano causado, não da ilicitude da conduta.", "Regresso contra o agente: dolo ou culpa; a culpa basta; não afasta a responsabilidade perante o terceiro.", "CF: \"assegurado o direito de regresso contra o responsável\"; Código Civil: \"ressalvado direito regressivo contra os causadores\".", "A pessoa de direito privado que não presta serviço público não consta do § 6º pela letra."]),
  PEG([["Só o ato ilícito do agente gera responsabilidade objetiva do Estado.", "A conduta **lícita** também pode gerar dever de indenizar: o fundamento é o dano causado, não a ilicitude."], ["O regresso contra o agente independe de culpa.", "Exige **dolo ou culpa** (CF, art. 37, § 6º); a culpa basta."], ["A ação regressiva exclui a responsabilidade do Estado perante a vítima.", "Não exclui: são vínculos distintos; a vítima aciona a pessoa jurídica."], ["Empresa pública que explora atividade econômica responde pelo § 6º.", "Pela letra, só a prestadora de **serviço público** consta do § 6º."]])],
 "ilustracaoSugerida": [],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, compare e tabela de P1-DA-6.2", "CF, art. 37, § 6º; Código Civil, art. 43", "MapasPro — Responsabilidade Civil do Estado (seções 4 e 5), conferido; não entrou a exigência de \"ato ilícito\" para a responsabilidade objetiva"]}

# ===================== P1-DA-6.3 =====================
R["P1-DA-6.3"] = {"versao": "v3", "cobranca": {"itens": 4, "ce": 3, "fonte": FONTE_COB + " Poucas questões neste item; o tema costuma vir dentro de 6.1 e 6.4."},
 "blocos": [
  S("Omissão: o que a letra diz e o que não diz", "aviso"),
  T("A letra do § 6º do art. 37 da CF (\"causarem\") e a do art. 43 do Código Civil (\"causem danos\") não empregam a palavra omissão. A omissão relevante para a responsabilização pressupõe **dever jurídico de agir**, e não mera possibilidade de agir; e, sem dano e sem nexo causal entre a omissão e o dano, não há dever de indenizar. O Estado não é segurador universal."),
  compare("P1-DA-6.3", 0),
  esquema_pacote("P1-DA-6.3", 0),
  B("regra", "Tema 592 do STF (RE 841.526)", "Tese: \"" + TESE_592 + "\" Quando há dever específico de proteção, a omissão pode gerar responsabilidade objetiva; ainda assim exigem-se o dano e o nexo entre a omissão e o resultado."),
  B("atencao", "\"Omissão = subjetiva\" não é regra absoluta", "A fórmula \"ação gera responsabilidade objetiva; omissão gera responsabilidade subjetiva\" é uma síntese doutrinária, não texto de lei, e o STF a afasta no dever específico de proteção (Tema 592). O que decide é o dever jurídico de agir, o dano e o nexo; não a simples natureza omissiva da conduta."),
  REL(["O § 6º e o art. 43 não mencionam omissão: a responsabilidade por omissão é construção doutrinária e jurisprudencial.", "Omissão relevante: dever jurídico de agir, não mera possibilidade de agir.", "Sem dano e sem nexo entre a omissão e o dano, não há indenização; se o dano ocorreria de todo modo, não há nexo.", "Tema 592: inobservado o dever específico de proteção (CF, art. 5º, XLIX), o Estado responde pela morte de detento.", "\"Omissão é sempre subjetiva\" é síntese doutrinária; o STF admite responsabilidade objetiva por omissão no dever específico.", "O Estado não é segurador universal: responde quando presentes os pressupostos, não por todo dano."]),
  PEG([["A omissão do Estado gera sempre responsabilidade subjetiva, com prova de culpa.", "Não é regra absoluta: no dever específico de proteção o STF reconhece responsabilidade **objetiva** (Tema 592)."], ["O § 6º do art. 37 prevê expressamente a responsabilidade por omissão.", "A letra fala nos danos que os agentes **\"causarem\"**; não emprega a palavra omissão."], ["Basta a possibilidade de agir para responsabilizar o Estado pela omissão.", "Exige-se **dever jurídico** de agir, além de dano e nexo."], ["Provada a ilicitude da omissão, o dever de indenizar é automático.", "Sem **nexo** entre a omissão e o dano não há indenização: se o dano ocorreria de todo modo, não há causalidade."], ["O Estado responde por qualquer dano sofrido por pessoa sob sua custódia.", "Responde quando **inobservado o dever específico de proteção** e presentes dano e nexo (Tema 592); não é segurador universal."]])],
 "ilustracaoSugerida": [],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, compare e esquema de P1-DA-6.3", "CF, art. 5º, XLIX, e art. 37, § 6º; Código Civil, art. 43", "STF, Tema 592 (RE 841.526): tese conforme a notícia oficial do STF de 30/3/2016 e a reprodução pelo STJ (AgInt no REsp 2.106.935/SC), conferência dirigida de 28/10/2026; a reconferir pelo QA no portal do STF", "MapasPro — Responsabilidade Civil do Estado (seções 4 e 8), conferido; não entrou a dicotomia absoluta \"ato ilícito = objetiva / omissão = subjetiva\""]}

# ===================== P1-DA-6.4 =====================
R["P1-DA-6.4"] = {"versao": "v3", "cobranca": {"itens": 5, "ce": 4, "fonte": FONTE_COB + " Poucas questões neste item; os requisitos são cobrados dentro de 6.1."},
 "blocos": [
  S("Três requisitos, nenhuma culpa", "alvo"),
  T("Os requisitos para demonstrar a responsabilidade do Estado são a **conduta** do agente, nessa qualidade, o **dano** e o **nexo causal** entre eles; a culpa da pessoa jurídica não integra o rol. A referência a \"dolo ou culpa\" no § 6º está na cláusula do regresso, não na parte que trata da responsabilidade da pessoa jurídica."),
  esquema_pacote("P1-DA-6.4", 0),
  FL("Teste em três perguntas", ["O dano veio de conduta de agente atuando nessa qualidade?", "Houve dano efetivo, e não mera potencialidade?", "Há nexo de causalidade entre a conduta e o dano?"]),
  DOIS("O que entra e o que não entra na demonstração", "Entra", ["Conduta do agente, nessa qualidade (\"nessa qualidade\", CF e Código Civil)", "Dano efetivo a terceiro", "Nexo de causalidade: o dano foi causado pela conduta"], "Não entra", ["Culpa da pessoa jurídica", "Ilicitude da conduta (a lícita também pode gerar dever de indenizar)", "Dolo ou culpa do agente: só importam para o regresso"], "\"Durante a atuação\" não é \"por causa da atuação\": coincidência temporal não é nexo"),
  B("atencao", "Nessa qualidade", "Se o dano resulta de atividade estritamente particular do agente, sem relação com o cargo, falta o requisito da conduta nessa qualidade, e o § 6º não se aplica."),
  lei("P1-DA-6.4", 0),
  REL(["Requisitos: conduta de agente nessa qualidade, dano efetivo e nexo causal.", "A culpa da pessoa jurídica não integra o rol; \"dolo ou culpa\" está na cláusula do regresso.", "Dano efetivo, e não mera potencialidade.", "Nexo é causa e efeito (\"causarem\"); coincidência temporal não basta.", "Atividade estritamente particular do agente, sem relação com o cargo, não é conduta nessa qualidade.", "A conduta lícita pode gerar dever de indenizar; a ilicitude não é requisito."]),
  PEG([["A vítima deve provar a culpa da Administração.", "Não: a responsabilidade é objetiva; prova-se conduta, dano e **nexo**."], ["O dano potencial basta para a indenização.", "Exige-se dano **efetivo**."], ["Dano ocorrido durante o expediente do agente é sempre imputável ao Estado.", "\"Durante\" não é \"por causa\": é preciso **nexo** entre a conduta e o dano."], ["A ilicitude da conduta é requisito da responsabilidade objetiva.", "Não é; a conduta **lícita** também pode gerar dever de indenizar."]])],
 "ilustracaoSugerida": [],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, esquema e baseLegal de P1-DA-6.4", "CF, art. 37, § 6º; Código Civil, art. 43", "MapasPro — Responsabilidade Civil do Estado (seções 6 e 7), conferido"]}

# ===================== P1-DA-6.5 =====================
R["P1-DA-6.5"] = {"versao": "v3", "cobranca": {"itens": 5, "ce": 4, "fonte": FONTE_COB + " Poucas questões neste item; as excludentes são cobradas dentro de 6.1."},
 "blocos": [
  S("Excluir ou atenuar", "balanca"),
  T("A causa **excludente** afasta o dever de indenizar; a **atenuante** apenas reduz a responsabilidade e o valor a indenizar. O § 6º do art. 37 não enumera umas nem outras: são construção doutrinária e jurisprudencial sobre o nexo causal."),
  tabela_pacote("P1-DA-6.5", 0),
  ESC("Da exclusão à atenuação", "Exclui", "Não afeta", [["Força maior ou caso fortuito", "como causa exclusiva do dano, rompe o nexo e exclui (risco administrativo)"], ["Fato exclusivo de terceiro", "afasta o nexo com a conduta do agente; exclui"], ["Culpa exclusiva da vítima", "exclui a responsabilidade"], ["Culpa concorrente da vítima", "atenua: reduz a responsabilidade e o valor, sem excluir"], ["Culpa do agente ou regresso", "não exclui nem atenua a responsabilidade da pessoa jurídica perante o terceiro"]]),
  compare("P1-DA-6.5", 0),
  B("atencao", "Excludente só quando exclusiva", "Força maior, fato de terceiro e culpa da vítima só excluem quando são a causa **exclusiva** do dano. Se o Estado concorreu para o resultado — uma enchente previsível sem drenagem, uma morte sob custódia com dever específico de proteção descumprido (Tema 592) — o nexo subsiste e, no máximo, a responsabilidade é atenuada."),
  REL(["Excludente afasta o dever de indenizar; atenuante só reduz a responsabilidade e o valor.", "Excluem: força maior e caso fortuito (causa exclusiva), fato exclusivo de terceiro, culpa exclusiva da vítima.", "Culpa concorrente da vítima: atenua, não exclui.", "Culpa do agente e regresso ressalvado: não excluem nem atenuam a responsabilidade perante o terceiro.", "Risco administrativo admite excludentes; risco integral, conceitualmente, não.", "Só exclui o que é causa exclusiva: se o Estado concorreu, o nexo subsiste."]),
  PEG([["A culpa concorrente da vítima exclui a responsabilidade do Estado.", "**Atenua**, reduzindo o valor; exclui só a culpa **exclusiva** da vítima."], ["No risco integral, a força maior exclui a responsabilidade.", "No risco integral, conceitualmente, **não** há excludentes; elas valem no risco administrativo."], ["A culpa do agente exclui a responsabilidade da pessoa jurídica.", "Não exclui nem atenua; só fundamenta o **regresso**."], ["A força maior sempre exclui a responsabilidade do Estado.", "Só quando é causa **exclusiva**; se o Estado concorreu (omissão em dever específico), o nexo subsiste."]])],
 "ilustracaoSugerida": [{"onde": "junto da escala Da exclusão à atenuação", "oQue": "uma balança com o nexo causal no fiel: de um lado a conduta do Estado, do outro a causa externa; quando a causa externa é exclusiva, a balança tomba e o nexo se rompe", "porQue": "mostra que a excludente é uma questão de nexo, não de culpa"}],
 "fontes": ["Pacote v1.14 — resumo, emUmMinuto, tabela e compare de P1-DA-6.5", "CF, art. 37, § 6º; Código Civil, art. 43; STF, Tema 592 (RE 841.526), conferência dirigida de 28/10/2026", "MapasPro — Responsabilidade Civil do Estado (seção 6), conferido; não entraram \"suicida em cadeia = culpa exclusiva\" nem as excludentes como regra automática"]}

